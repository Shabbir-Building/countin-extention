{
  "manifest_version": 3,
  "name": "LinkedIn Comment Counter",
  "version": "1.0.0",
  "description": "Count LinkedIn comment clicks.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
